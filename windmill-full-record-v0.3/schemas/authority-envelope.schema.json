{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/resilient-ai-safety-principles/schemas/authority-envelope.schema.json",
  "title": "Authority Envelope",
  "description": "Machine-readable authority boundary for Resilient AI Safety Principles v0.2.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "authority_envelope_id",
    "subject",
    "permissions",
    "validity",
    "limits",
    "delegation",
    "issuer",
    "status",
    "trace_reference"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2.0"
    },

    "authority_envelope_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },

    "subject": {
      "$ref": "#/$defs/subject"
    },

    "permissions": {
      "$ref": "#/$defs/permissions"
    },

    "validity": {
      "$ref": "#/$defs/validity"
    },

    "limits": {
      "$ref": "#/$defs/limits"
    },

    "impact_boundary": {
      "$ref": "#/$defs/impactBoundary"
    },

    "delegation": {
      "$ref": "#/$defs/delegation"
    },

    "issuer": {
      "$ref": "#/$defs/issuer"
    },

    "approval": {
      "$ref": "#/$defs/approval"
    },

    "status": {
      "type": "string",
      "enum": [
        "REQUESTED",
        "GRANTED",
        "ACTIVE",
        "FROZEN",
        "EXPIRED",
        "REVOKED",
        "CONSUMED",
        "SUPERSEDED",
        "DENIED"
      ]
    },

    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },

    "derived_from": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },

    "reason": {
      "type": "string",
      "minLength": 1
    },

    "trace_reference": {
      "type": "string",
      "minLength": 1
    },

    "issued_at": {
      "$ref": "#/$defs/dateTime"
    },

    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },

  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "subject_type"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },

        "subject_type": {
          "type": "string",
          "enum": [
            "AI_AGENT",
            "AI_MODEL",
            "SERVICE",
            "HUMAN",
            "NODE",
            "PROCESS",
            "OTHER"
          ]
        },

        "domain": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },

    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions",
        "targets",
        "scope"
      ],
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },

        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/target"
          }
        },

        "scope": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "array",
              "object",
              "null"
            ]
          }
        }
      }
    },

    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "target_type"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },

        "target_type": {
          "type": "string",
          "minLength": 1
        },

        "domain": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },

    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid_from",
        "valid_until",
        "renewable"
      ],
      "properties": {
        "valid_from": {
          "$ref": "#/$defs/dateTime"
        },

        "valid_until": {
          "$ref": "#/$defs/dateTime"
        },

        "renewable": {
          "type": "boolean"
        },

        "renewal_requires_reapproval": {
          "type": "boolean",
          "default": true
        }
      }
    },

    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_operations"
      ],
      "properties": {
        "max_operations": {
          "type": "integer",
          "minimum": 1
        },

        "max_runtime_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },

        "max_resource_units": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },

        "max_cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },

        "max_data_items": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },

        "max_fan_out": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },

    "impactBoundary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_affected_entities": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },

        "external_effect_allowed": {
          "type": "boolean"
        },

        "cross_domain_effect_allowed": {
          "type": "boolean"
        },

        "irreversible_effect_allowed": {
          "type": "boolean"
        },

        "financial_limit": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },

    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },

        "max_depth": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },

        "must_reduce_scope": {
          "type": "boolean",
          "default": true
        },

        "allowed_subject_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "AI_AGENT",
              "AI_MODEL",
              "SERVICE",
              "HUMAN",
              "NODE",
              "PROCESS",
              "OTHER"
            ]
          }
        }
      },

      "allOf": [
        {
          "if": {
            "properties": {
              "allowed": {
                "const": false
              }
            },
            "required": [
              "allowed"
            ]
          },
          "then": {
            "properties": {
              "max_depth": {
                "type": [
                  "integer",
                  "null"
                ],
                "enum": [
                  0,
                  null
                ]
              }
            }
          }
        }
      ]
    },

    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer_id",
        "issuer_type"
      ],
      "properties": {
        "issuer_id": {
          "type": "string",
          "minLength": 1
        },

        "issuer_type": {
          "type": "string",
          "enum": [
            "AUTHORITY_SERVICE",
            "HUMAN",
            "POLICY_ENGINE",
            "MULTI_PARTY_APPROVAL",
            "OTHER"
          ]
        },

        "domain": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },

    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "approved_by",
        "independent_from_subject"
      ],
      "properties": {
        "approval_id": {
          "type": "string",
          "minLength": 1
        },

        "approved_by": {
          "type": "string",
          "minLength": 1
        },

        "independent_from_subject": {
          "type": "boolean"
        },

        "approved_at": {
          "$ref": "#/$defs/dateTime"
        }
      }
    },

    "dateTime": {
      "type": "string",
      "format": "date-time"
    }
  },

  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "GRANTED",
              "ACTIVE"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "approval",
          "issued_at"
        ]
      }
    },

    {
      "if": {
        "properties": {
          "status": {
            "const": "ACTIVE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "independent_from_subject": {
                "const": true
              }
            },
            "required": [
              "independent_from_subject"
            ]
          }
        }
      }
    },

    {
      "if": {
        "properties": {
          "delegation": {
            "properties": {
              "allowed": {
                "const": true
              }
            },
            "required": [
              "allowed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "delegation": {
            "required": [
              "max_depth",
              "must_reduce_scope"
            ]
          }
        }
      }
    }
  ]
}
