{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kazene.org/schemas/authorization-execution-conformance-case.schema.json",
  "title": "Authorization–Execution Scope Conformance Case",
  "description": "A cross-protocol conformance case for validating that an execution remains within its authorization scope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "case_type",
    "expected_outcome",
    "authorization_records",
    "execution_records",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^case:[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "case_type": {
      "const": "authorization_execution_scope"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "expected_outcome": {
      "type": "string",
      "enum": [
        "conformant",
        "nonconformant"
      ]
    },
    "authorization_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/authorization_record"
      }
    },
    "execution_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/execution_record"
      }
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      }
    }
  },
  "$defs": {
    "authorization_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "decision",
        "trace_ref",
        "authorized_scope",
        "decided_at"
      ],
      "properties": {
        "authorization_id": {
          "type": "string",
          "pattern": "^kazene:authorization:[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "decision": {
          "type": "string",
          "enum": [
            "authorized",
            "denied",
            "human_review_required"
          ]
        },
        "trace_ref": {
          "type": "string",
          "pattern": "^kazene:trace:[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "authorized_scope": {
          "$ref": "#/$defs/authorized_scope"
        },
        "authority_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "authorized_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "actors",
        "tools",
        "resources",
        "cost_limit",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "action": {
          "type": "string",
          "pattern": "^action://[a-zA-Z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]+$"
        },
        "actors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "cost_limit": {
          "$ref": "#/$defs/money"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "execution_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "authorization_ref",
        "observed_action",
        "execution_status",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "execution_id": {
          "type": "string",
          "pattern": "^kazene:execution:[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "authorization_ref": {
          "type": "string",
          "pattern": "^kazene:authorization:[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "observed_action": {
          "$ref": "#/$defs/observed_action"
        },
        "execution_status": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed",
            "blocked",
            "partial"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "outcome_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "observed_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "actor",
        "tool",
        "resource",
        "cost"
      ],
      "properties": {
        "action": {
          "type": "string",
          "pattern": "^action://[a-zA-Z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]+$"
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "cost": {
          "$ref": "#/$defs/money"
        }
      }
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_unique_authorization_ids",
        "require_unique_execution_ids",
        "require_registered_authorization",
        "require_authorized_decision",
        "require_action_match",
        "require_actor_scope",
        "require_tool_scope",
        "require_resource_scope",
        "require_cost_scope",
        "require_time_scope"
      ],
      "properties": {
        "require_unique_authorization_ids": {
          "type": "boolean"
        },
        "require_unique_execution_ids": {
          "type": "boolean"
        },
        "require_registered_authorization": {
          "type": "boolean"
        },
        "require_authorized_decision": {
          "type": "boolean"
        },
        "require_action_match": {
          "type": "boolean"
        },
        "require_actor_scope": {
          "type": "boolean"
        },
        "require_tool_scope": {
          "type": "boolean"
        },
        "require_resource_scope": {
          "type": "boolean"
        },
        "require_cost_scope": {
          "type": "boolean"
        },
        "require_time_scope": {
          "type": "boolean"
        }
      }
    }
  }
}
