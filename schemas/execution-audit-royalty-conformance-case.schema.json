{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kazene.org/schemas/execution-audit-royalty-conformance-case.schema.json",
  "title": "Execution–Audit–Royalty Gate Conformance Case",
  "description": "A cross-protocol conformance case for verifying that Royalty processing is gated by a valid Audit of the referenced Execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "case_type",
    "expected_outcome",
    "execution_records",
    "audit_records",
    "royalty_records",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "const": "0.4.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^case:[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "case_type": {
      "const": "execution_audit_royalty_gate"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "expected_outcome": {
      "type": "string",
      "enum": [
        "conformant",
        "nonconformant"
      ]
    },
    "execution_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/execution_record"
      }
    },
    "audit_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/audit_record"
      }
    },
    "royalty_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/royalty_record"
      }
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      }
    }
  },
  "$defs": {
    "execution_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "authorization_ref",
        "execution_status",
        "completed_at"
      ],
      "properties": {
        "execution_id": {
          "type": "string",
          "pattern": "^kazene:execution:[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "authorization_ref": {
          "type": "string",
          "pattern": "^kazene:authorization:[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "execution_status": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed",
            "blocked",
            "partial"
          ]
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "outcome_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "audit_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_id",
        "request_execution_ref",
        "report_execution_ref",
        "verdict",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "audit_id": {
          "type": "string",
          "pattern": "^kazene:audit:[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "request_execution_ref": {
          "type": "string",
          "pattern": "^kazene:execution:[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "report_execution_ref": {
          "type": "string",
          "pattern": "^kazene:execution:[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "pending"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "auditor_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "royalty_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "royalty_id",
        "execution_ref",
        "audit_ref",
        "royalty_status",
        "initiated_at"
      ],
      "properties": {
        "royalty_id": {
          "type": "string",
          "pattern": "^kazene:royalty:[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "execution_ref": {
          "type": "string",
          "pattern": "^kazene:execution:[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "audit_ref": {
          "type": "string",
          "pattern": "^kazene:audit:[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "royalty_status": {
          "type": "string",
          "enum": [
            "eligible",
            "allocated",
            "blocked"
          ]
        },
        "initiated_at": {
          "type": "string",
          "format": "date-time"
        },
        "beneficiary_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_unique_execution_ids",
        "require_unique_audit_ids",
        "require_unique_royalty_ids",
        "require_registered_execution_for_audit",
        "require_preserved_execution_binding",
        "require_audit_after_execution",
        "require_registered_execution_for_royalty",
        "require_registered_audit_for_royalty",
        "require_royalty_execution_match",
        "require_passed_audit_before_royalty",
        "require_royalty_after_audit"
      ],
      "properties": {
        "require_unique_execution_ids": {
          "type": "boolean"
        },
        "require_unique_audit_ids": {
          "type": "boolean"
        },
        "require_unique_royalty_ids": {
          "type": "boolean"
        },
        "require_registered_execution_for_audit": {
          "type": "boolean"
        },
        "require_preserved_execution_binding": {
          "type": "boolean"
        },
        "require_audit_after_execution": {
          "type": "boolean"
        },
        "require_registered_execution_for_royalty": {
          "type": "boolean"
        },
        "require_registered_audit_for_royalty": {
          "type": "boolean"
        },
        "require_royalty_execution_match": {
          "type": "boolean"
        },
        "require_passed_audit_before_royalty": {
          "type": "boolean"
        },
        "require_royalty_after_audit": {
          "type": "boolean"
        }
      }
    }
  }
}
