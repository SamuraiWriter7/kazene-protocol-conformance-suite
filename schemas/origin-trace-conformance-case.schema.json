{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kazene.org/schemas/origin-trace-conformance-case.schema.json",
  "title": "Origin–Trace Conformance Case",
  "description": "A self-contained cross-protocol test case for validating Origin-to-Trace linkage integrity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "case_type",
    "expected_outcome",
    "origin_records",
    "trace_records",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^case:[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "case_type": {
      "const": "origin_trace_linkage"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "expected_outcome": {
      "type": "string",
      "enum": [
        "conformant",
        "nonconformant"
      ]
    },
    "origin_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/origin_record"
      }
    },
    "trace_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/trace_record"
      }
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      }
    }
  },
  "$defs": {
    "origin_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_id",
        "origin_type",
        "status",
        "source_ref",
        "registered_at"
      ],
      "properties": {
        "origin_id": {
          "type": "string",
          "pattern": "^kazene:origin:[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "origin_type": {
          "type": "string",
          "enum": [
            "human_input",
            "document",
            "dataset",
            "model_output",
            "protocol_structure",
            "external_event"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "revoked",
            "superseded",
            "disputed"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "registered_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "trace_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "event_type",
        "origin_refs",
        "recorded_at"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^kazene:trace:[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "ingestion",
            "transformation",
            "derivation",
            "handoff",
            "observation"
          ]
        },
        "origin_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^kazene:origin:[a-z0-9][a-z0-9._-]{2,127}$"
          }
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_unique_origin_ids",
        "require_unique_trace_ids",
        "require_registered_origin",
        "require_active_origin"
      ],
      "properties": {
        "require_unique_origin_ids": {
          "type": "boolean"
        },
        "require_unique_trace_ids": {
          "type": "boolean"
        },
        "require_registered_origin": {
          "type": "boolean"
        },
        "require_active_origin": {
          "type": "boolean"
        }
      }
    }
  }
}
